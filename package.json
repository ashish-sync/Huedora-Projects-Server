{
  "name": "tylo-one-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:parsers && node --watch src/index.js",
    "start": "node src/index.js",
    "postinstall": "npm run build:parsers",
    "prestart": "npm run build:parsers",
    "seed": "node src/seed.js",
    "reset:data": "node scripts/reset-all-data.js",
    "fresh-start:keep-users": "node scripts/fresh-start-keep-users.js",
    "purge:demo": "node scripts/purge-demo-data.js",
    "purge:demo:dry": "node scripts/purge-demo-data.js --dry-run",
    "purge:all-camps": "node scripts/purge-all-camps.js",
    "purge:all-camps:dry": "node scripts/purge-all-camps.js --dry-run",
    "predeploy:verify": "node scripts/predeploy-verify.js",
    "test:purge-markers": "node --test src/utils/purgeDemoData.test.js",
    "test:camp-filters": "node --test src/modules/campOps/campOps.filters.test.js",
    "test:camp-alerts": "node --test src/modules/campOps/campOps.alertFilters.test.js",
    "test:camp-coordinators": "node --test src/modules/campOps/campOps.coordinatorNotify.test.js",
    "test:text-format": "node --test src/utils/textFormat.test.js",
    "test:camp-ops": "node --test src/modules/campOps/*.test.js",
    "geo:build": "node scripts/buildIndiaGeoSeed.js",
    "geo:build-cities": "node scripts/buildTyloCitySeed.js",
    "geo:reseed": "node scripts/reseed-geo.js",
    "geo:clean-pins": "node scripts/cleanPinCodeMaster.js",
    "test:manual-paste": "node scripts/test-manual-paste-extract.js",
    "test:camp-import": "node scripts/test-camp-import-validation.js",
    "test:persistence": "node scripts/verify-persistence.js",
    "test:camp-parser": "npm run build:parsers && node scripts/test-camp-request-parser.js",
    "build:parsers": "tsc -p src/modules/campOps/parsers/tsconfig.json",
    "test:camp-one": "node scripts/camp-one-e2e-test.js",
    "test:camp-lifecycle-qa": "node scripts/camp-one-lifecycle-qa.js",
    "seed:camp-one": "node -e \"import('./src/config/db.js').then(async ({connectDb,disconnectDb})=>{await connectDb(); const {ensureSeed}=await import('./src/seed.js'); await ensureSeed(); await disconnectDb();})\"",
    "bulk:users:template": "node scripts/bulk-import-users.js --generate-template",
    "bulk:users": "node scripts/bulk-import-users.js",
    "test:bulk-users": "node --test scripts/bulk-import-users.test.js scripts/teamAccessProfiles.test.js",
    "test:legacy-migration": "node --test src/utils/legacyMigration.test.js",
    "purge:test-users": "node scripts/purge-test-users.js",
    "check:rebrand": "node scripts/check-rebrand.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "imapflow": "^1.5.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mailparser": "^3.9.14",
    "mongoose": "^8.9.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "uuid": "^11.0.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.2",
    "typescript": "^5.9.3"
  }
}
