PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# Render production example:
# CLIENT_ORIGIN=https://huedora-projects.onrender.com

# ─── Local development (default) ─────────────────────────────────────────────
USE_MONGOOSE=false
USE_MEMORY_DB=false
MONGODB_URI=mongodb://127.0.0.1:27017/tylo-one
# DATA_DIR=./data

# ─── Production (Render + MongoDB Atlas) ───────────────────────────────────────
# REQUIRED on the API service — paste the FULL string from Atlas → Connect → Drivers.
# Example (replace USER, PASSWORD, and cluster host):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/tylo-one?retryWrites=true&w=majority
# URL-encode special characters in PASSWORD (@ : / ? # [ ] become %40 %3A etc).
# USE_MONGOOSE=true is optional in production if MONGODB_URI is already set.
# Never enable these in production unless you intend a one-shot wipe/reseed:
# RESET_ALL_DATA_ON_BOOT=false
# RESEED_GEO_ON_BOOT=false
# USE_MEMORY_DB=false
# Optional: mount a Render persistent disk and point uploads here
# UPLOADS_DIR=/var/data/uploads

# REQUIRED in production (32+ random characters each — no placeholders)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Optional first-run only: create the initial Admin user if none exists.
# Leave blank after first admin is created. Password min 12 characters.
# BOOTSTRAP_ADMIN_EMAIL=you@company.com
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Administrator
# One-shot password recovery for that bootstrap email (set true, redeploy, then false):
# BOOTSTRAP_ADMIN_RESET=false

UPLOAD_MAX_BYTES=10485760
SMTP_ENABLED=false

# Dev-only sample data (ignored when NODE_ENV=production)
SEED_AGREEMENT_SAMPLES=false
SEED_DEMO_USERS=false
# Camp One demo client, camps, and operator (dev only). Set false before pre-deploy / UAT.
SEED_CAMP_ONE_DEMO=false

# One-shot production wipe: set RESET_ALL_DATA_ON_BOOT=true for one deploy, then turn it off.
# RESET_ALL_DATA_ON_BOOT=false

# One-shot wipe that KEEPS users/roles/logins AND geo city masters (states/districts/cities/zones/PINs).
# Clears camps, assets, products, contacts, and other masters. Set true for one Render deploy, then false.
# FRESH_START_KEEP_USERS_ON_BOOT=false

# One-shot soft-delete of ALL Camp One camps (every lifecycle stage). Keeps Client Master and other data.
# Set true for one Render deploy, then set back to false.
# PURGE_ALL_CAMPS_ON_BOOT=false

# TYLO Care team accounts (production MongoDB). Auto-imports when fewer than ~20 @tylocare.com users exist.
# Prefer TEAM_USERS_PASSWORD_HASH (bcrypt) over plaintext. Or set BULK_USERS_DEFAULT_PASSWORD in the host secret store.
# BULK_USERS_DEFAULT_PASSWORD=
# TEAM_USERS_PASSWORD_HASH=
# One-shot import or password reset for all team users in the CSV:
# TEAM_USERS_IMPORT_ON_BOOT=true
# TEAM_USERS_RESET_PASSWORD_ON_BOOT=true
# TEAM_USERS_CSV=scripts/data/team-users-tylocare.csv
# One-shot geo master reload (states, districts, cities, zones) from bundled india-geo.json:
# RESEED_GEO_ON_BOOT=false
# No separate Camp One secrets are required. API is mounted at /api/v1/camp-ops.
# Email ingest (IMAP + rules UI) — optional:
# EMAIL_IMAP_ENABLED=true
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_IMAP_USER=
# EMAIL_IMAP_PASSWORD=
# EMAIL_IMAP_MAILBOX=INBOX
# EMAIL_ALLOWED_DOMAINS=
# EMAIL_ALLOWED_SENDERS=
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# EMAIL_SMTP_FROM=
# EMAIL_REPLY_ENABLED=true
# EMAIL_SERVICE_USER_EMAIL=email-bot@huedoraconnect.com
# Camp coordinator/manager alert copies (defaults on when SMTP + EMAIL_REPLY_ENABLED are set)
# CAMP_STAKEHOLDER_EMAIL_ENABLED=true
# WhatsApp Cloud API webhook — optional:
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_SERVICE_USER_EMAIL=whatsapp-bot@huedoraconnect.com

# Google Maps / Places (Camp address autocomplete). Served to the SPA at runtime if the
# client build does not include VITE_GOOGLE_MAPS_API_KEY. Restrict this key by HTTP referrer.
# GOOGLE_MAPS_API_KEY=
